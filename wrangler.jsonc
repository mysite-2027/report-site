{
  // مهم: يجب أن يطابق "name" اسم الـ Worker الحالي في لوحة Cloudflare
  "name": "report-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ALERT_EMAIL": "muyassir.reports@gmail.com",
    "MAIL_FROM": "Muyassir <noreply@muyassir.org>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "report-site-db",
      "database_id": "14364c59-a85b-4811-af2b-807fcb7425e9"
    }
  ]
}
